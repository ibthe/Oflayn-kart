<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd"
    version="5"
    map-background="#F3F5EF"
    map-background-outside="#E4E9E0">

    <!-- Water: calm blue with subtle shoreline contrast. -->
    <rule e="way" k="natural" v="water|bay">
        <area fill="#B9DCEB" stroke="#A6CFDF" stroke-width="0.45"/>
    </rule>
    <rule e="way" k="waterway" v="riverbank|dock">
        <area fill="#B9DCEB" stroke="#A6CFDF" stroke-width="0.35"/>
    </rule>
    <rule e="way" k="waterway" v="river|canal">
        <line stroke="#A9D4E5" stroke-width="1.15" />
    </rule>
    <rule e="way" k="waterway" v="stream|ditch|drain">
        <line stroke="#B5DCEB" stroke-width="0.55" />
    </rule>

    <!-- Natural and green areas. -->
    <rule e="way" k="natural" v="wood|forest">
        <area fill="#D5E6D0" stroke="#C6DCC1" stroke-width="0.35"/>
    </rule>
    <rule e="way" k="landuse" v="forest">
        <area fill="#D1E3CC" stroke="#C1D8BC" stroke-width="0.35"/>
    </rule>
    <rule e="way" k="landuse" v="grass|meadow|farmland|farm|orchard|vineyard">
        <area fill="#E7EFDC"/>
    </rule>
    <rule e="way" k="leisure" v="park|garden|nature_reserve|golf_course|recreation_ground">
        <area fill="#DCEBD4" stroke="#C9DFC2" stroke-width="0.35"/>
    </rule>
    <rule e="way" k="natural" v="scrub|heath">
        <area fill="#E2EBD8"/>
    </rule>
    <rule e="way" k="natural" v="beach">
        <area fill="#F2E8CB"/>
    </rule>
    <rule e="way" k="natural" v="glacier|snowfield">
        <area fill="#F8FBFC" stroke="#D9E8ED" stroke-width="0.4"/>
    </rule>

    <!-- Built-up areas and buildings. -->
    <rule e="way" k="landuse" v="residential|commercial|retail|industrial">
        <area fill="#ECEDE7"/>
    </rule>
    <rule e="way" k="building" v="*" zoom-min="13">
        <area fill="#D9DAD4" stroke="#C7C9C1" stroke-width="0.35"/>
    </rule>

    <!-- Roads are layered: soft casing first, then a warm, readable centre. -->
    <rule e="way" k="highway" v="motorway|trunk|primary|secondary|tertiary|unclassified|residential|living_street|service|track|path|footway|cycleway">
        <line stroke="#FFFFFF" stroke-width="3.2" />
    </rule>
    <rule e="way" k="highway" v="motorway|trunk">
        <line stroke="#E8B978" stroke-width="2.25"/>
    </rule>
    <rule e="way" k="highway" v="primary">
        <line stroke="#F0C98F" stroke-width="1.9"/>
    </rule>
    <rule e="way" k="highway" v="secondary">
        <line stroke="#F5D9AD" stroke-width="1.55"/>
    </rule>
    <rule e="way" k="highway" v="tertiary|unclassified">
        <line stroke="#FFFFFF" stroke-width="1.25"/>
    </rule>
    <rule e="way" k="highway" v="residential|living_street|service">
        <line stroke="#FFFFFF" stroke-width="0.95"/>
    </rule>
    <rule e="way" k="highway" v="track">
        <line stroke="#D6C9A9" stroke-width="0.85" stroke-dasharray="3,2"/>
    </rule>
    <rule e="way" k="highway" v="path|footway|cycleway">
        <line stroke="#C5B99F" stroke-width="0.55" stroke-dasharray="2,2"/>
    </rule>

    <!-- Railways and administrative borders. -->
    <rule e="way" k="railway" v="rail|light_rail|subway">
        <line stroke="#A9A9A3" stroke-width="0.65" stroke-dasharray="4,2"/>
    </rule>
    <rule e="way" k="boundary" v="administrative">
        <line stroke="#C7A6A6" stroke-width="0.45" stroke-dasharray="5,3"/>
    </rule>

    <!-- Labels: restrained ink and a light halo for legibility. -->
    <rule e="node" k="place" v="city|town|village|hamlet|suburb|neighbourhood">
        <caption k="name" font-size="12" fill="#46564B" stroke="#F3F5EF" stroke-width="2.2" />
    </rule>
    <rule e="way" k="waterway" v="river|canal" zoom-min="12">
        <pathText k="name" font-size="9" fill="#5E9DB8" stroke="#F3F5EF" stroke-width="2.0"/>
    </rule>
    <rule e="way" k="highway" v="motorway|trunk|primary|secondary" zoom-min="13">
        <pathText k="name" font-size="8" fill="#8A8170" stroke="#FFFFFF" stroke-width="1.8"/>
    </rule>
    <rule e="node" k="*" v="*" zoom-min="15">
        <caption k="name" font-size="8" fill="#687268" stroke="#F3F5EF" stroke-width="1.8"/>
    </rule>
</rendertheme>
